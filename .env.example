# ==============================================================================
# Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your local environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# GitHub & Machine User Configuration
# ------------------------------------------------------------------------------
# GITHUB_TOKEN: Personal Access Token (PAT) used by the GitHub CLI (gh) tool.
#
# CRITICAL: Populate this with a dedicated Machine User (bot account) PAT,
# NOT your personal/primary human developer account token.
#
# Reason: GitHub prevents users from approving their own Pull Requests.
# When the LangGraph agents generate and submit PRs using a machine user identity,
# human developers are free to review, approve, and merge those PRs without conflict.
#
# Expected Value: Fine-grained GitHub Personal Access Token (or Classic PAT with 'repo' scope)
# generated from the secondary bot / machine user account.
GITHUB_TOKEN=github_pat_your_machine_user_token_here

# ------------------------------------------------------------------------------
# LLM Provider API Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Discord Bot Tokens
# ------------------------------------------------------------------------------
DISCORD_TOKEN_MAIN=your_discord_bot_token_here
DISCORD_TOKEN_AGENT_DESIGNER=your_agent_designer_bot_token_here

# ------------------------------------------------------------------------------
# External Tool API Keys (Optional)
# ------------------------------------------------------------------------------
BRAVE_API_KEY=your_brave_search_api_key_here
RUNWAYML_API_SECRET=your_runway_api_key_here
SEATS_AERO_API_KEY=your_seats_aero_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# ------------------------------------------------------------------------------
# Storage & PKM Paths
# ------------------------------------------------------------------------------
PKM_DIR=/home/appuser/pkm
TASKS_DB_PATH=/home/appuser/pkm/tasks.db
PROJECTS_DB_PATH=/home/appuser/pkm/projects.db
KNOWLEDGE_DB_PATH=/home/appuser/pkm/.lancedb

# ------------------------------------------------------------------------------
# LangSmith Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=langgraph-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------------------
# Debug & Development Flags
# ------------------------------------------------------------------------------
IS_DEBUG=false
DEBUG_CHANNEL=
