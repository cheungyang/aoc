# ---------------------------------------------------------------------
# LangSmith Observability & Tracing (https://smith.langchain.com)
# ---------------------------------------------------------------------
# Set to 'true' to enable tracing of all agents, subgraphs, LLM calls, and tools
LANGSMITH_TRACING=false

# Your LangSmith API Key (starts with lsv2_pt_...)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# The LangSmith project to log traces to (defaults to 'default' if omitted)
LANGSMITH_PROJECT=default

# LangSmith API endpoint (defaults to US GCP region).
# If your account is in another region, change to:
# - EU: https://eu.api.smith.langchain.com
# - APAC: https://apac.api.smith.langchain.com
# - AWS US: https://aws.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------
# LLM Provider API Keys
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------
# Tool API Keys
# ---------------------------------------------------------------------
BRAVE_API_KEY=your_brave_api_key_here
SEATS_AERO_API_KEY=your_seats_aero_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here

# ---------------------------------------------------------------------
# On-device LLM (OpenAI-compatible server, e.g. LiteRT-LM)
# ---------------------------------------------------------------------
# Used by agents whose agent.json sets "provider": "local". Which model a tier
# maps to is decided in core/util/models.py, not here -- this is only where the
# server lives. There is deliberately no API key setting: the server does not
# authenticate, and graph_builder passes a placeholder explicitly so that the
# OPENAI_API_KEY above can never be posted to a local socket.
#
# NOTE: inside Docker, localhost is the container, not the host. docker-compose
# overrides this to host.docker.internal.
LOCAL_LLM_BASE_URL=http://localhost:9379/v1
# Seconds. Short turns measure about a second, but the server handles one
# request at a time, so a turn waits behind everything queued ahead of it. The
# openai client's 60s default would abort turns that were merely waiting.
LOCAL_LLM_TIMEOUT=300
# The server's hard context window, in tokens. MEASURE THIS -- it is set when
# the server starts, not by the model file, so loading a model that advertises
# a larger window does not raise it. Overflow the streaming endpoint and the
# server states its own limit ("... too long ... 7142 >= 4096").
# Exceeding it is a hard rejection, not a degradation.
LOCAL_LLM_CONTEXT_TOKENS=4096
# History budget for local agents, defaulting to half of the window above.
# CONTEXT_MAX_TOKENS (30000) is sized for Gemini and is over seven times this
# whole window, so without a separate budget the pruner would never fire before
# the server rejected the request. Half is reserved because the pruner measures
# conversation history only -- the system prompt and tool schemas are charged to
# the same window but counted nowhere.
# LOCAL_LLM_HISTORY_TOKENS=2048

# ---------------------------------------------------------------------
# Discord Bot Tokens
# ---------------------------------------------------------------------
DISCORD_TOKEN_MAIN=your_discord_bot_token_here
DISCORD_TOKEN_AGENT_DESIGNER=your_discord_bot_token_here
DISCORD_TOKEN_HOME_STEWARD=your_discord_bot_token_here

# ---------------------------------------------------------------------
# Debug Mode & Channel Restrictions
# ---------------------------------------------------------------------
IS_DEBUG=false
DEBUG_CHANNEL=aoc-debug

# ---------------------------------------------------------------------
# GitHub Machine User (branch pushes and PRs)
# ---------------------------------------------------------------------
# The bot's PAT is deliberately NOT a key in this file: load_dotenv() exports
# everything here, and gh would then claim GH_TOKEN / GITHUB_TOKEN from the
# environment, running every gh call as the bot and exposing the token to the
# worker's bash subprocesses. It lives in ./github_bot_token at the project
# root (chmod 600, gitignored), which the `.:/app` mount exposes to the
# container as /app/github_bot_token, and is injected only into the individual
# git/gh subprocesses that need it. Create it with:
#   install -m 600 /dev/null ./github_bot_token && pbpaste > ./github_bot_token
# Override only to keep the credential elsewhere; a path outside /app needs a
# mount of its own. See core/util/push_identity.py.
# AOC_BOT_TOKEN_FILE=/app/github_bot_token

# ---------------------------------------------------------------------
# Home Assistant
# ---------------------------------------------------------------------
# Base URL of the instance. Must have no trailing slash and must match the
# hostname configured in HA under Settings > System > Network, or HA's own
# OAuth metadata resolves to relative paths.
HA_BASE_URL=https://homeassistant.example.com

# Like the GitHub PAT above, the long-lived access token is NOT a key in this
# file: load_dotenv() exports everything here into the environment, where any
# subprocess an agent spawns could read it. It lives in ./home_assistant_token
# (chmod 600, gitignored AND dockerignored), which the `.:/app` mount exposes to
# the container. Create it with:
#   install -m 600 /dev/null ./home_assistant_token && pbpaste > ./home_assistant_token
# Override only to keep the credential elsewhere; a path outside /app needs a
# mount of its own. See core/integrations/homeassistant/client.py.
# HA_TOKEN_FILE=/app/home_assistant_token

# Master kill-switch for every mutating action (service calls, automation
# writes, reloads). Off by default: a read-only agent is useful and safe, and
# turning writes on should be a deliberate act.
HA_WRITE_ENABLED=false

# Seconds before a request to HA is abandoned. The default suits a LAN or a
# healthy tunnel; raise it if the NAS is slow to wake.
HA_REQUEST_TIMEOUT=20

# ---------------------------------------------------------------------
# Locale / Timezone
# ---------------------------------------------------------------------
# IANA timezone used for every date/time the agents state, for memory log
# filenames, and for interpreting cron schedules in agent configs.
# The container clock is UTC, so leaving this unset would make the agent
# think it is already tomorrow during your evening. Falls back to TZ, then
# to America/Los_Angeles.
TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------------
# Google Workspace / Gogcli Keyring Configuration
# ---------------------------------------------------------------------
# Keyring backend for headless container operations ('file' stores credentials in ./.gogcli)
GOG_KEYRING_BACKEND=file
# Keyring password used to encrypt and decrypt stored credentials non-interactively
GOG_KEYRING_PASSWORD=

# ---------------------------------------------------------------------
# Host Paths for Docker Mounts
# ---------------------------------------------------------------------
# Directory on the host holding the SSH keys used for git operations.
# Staged read-only at /mnt/.ssh, then copied into /home/appuser/.ssh and
# /root/.ssh by entrypoint.sh with per-user ownership.
# IMPORTANT: set this explicitly if you launch with `sudo docker compose`.
# Under sudo, $HOME is /root, so the default would stage root's keys instead
# of your own. On Synology DSM the real home is /var/services/homes/<user>/.ssh
# (e.g. SSH_HOST_DIR=/var/services/homes/cheungyang/.ssh).
SSH_HOST_DIR=

# ---------------------------------------------------------------------
# Knowledge Index & Embeddings
# ---------------------------------------------------------------------
# Gemini embedding model used for the vault index.
# NOTE: text-embedding-004 was retired and now returns 404; retired names are
# remapped to gemini-embedding-001 automatically.
EMBEDDING_MODEL=gemini-embedding-001
# Vector width. gemini-embedding-001 supports Matryoshka dimensions, so this
# must keep matching the existing table or the index needs a full rebuild.
EMBEDDING_DIMENSIONS=1536
#
# Embedding failures are fatal, not silent. If the API is reachable but a call
# fails, transient errors (429/503/timeout) are retried with backoff and then
# raise. Nothing writes hash-derived placeholder vectors into the index: those
# are indistinguishable from real embeddings once stored, so a single quota
# blip would otherwise leave a slice of the vault permanently unsearchable with
# no record of which chunks were affected.
#   - regenerate_lancedb.py aborts without touching the existing index.
#   - vault_search falls back to keyword (BM25) search and says so in its reply.
# Use --skip-embedding for a deliberate offline, keyword-only build.
# Knowledge store location (defaults to <PKM_DIR>/.lancedb)
# KNOWLEDGE_DB_PATH=
#
# Which vector store implementation to use: auto | lancedb | numpy
#
#   auto     (default) Probe for lancedb in a child process at startup and use
#            it if it loads; otherwise use the numpy store.
#   lancedb  Force LanceDB. Fast, but its wheels require a CPU with AVX2.
#   numpy    Force the parquet + numpy + tantivy store. Pure exhaustive scan,
#            no ANN index, runs on any CPU.
#
# The probe exists because lancedb does not fail cleanly on an unsupported CPU:
# the import executes an illegal instruction and the kernel kills the process,
# so it cannot be caught with try/except. The Celeron J4025 in the deployment
# NAS is one such CPU.
#
# Set this explicitly to skip the probe (it costs about a second at startup) or
# to pin a backend on hardware where either would work. The two produce
# equivalent results, so switching only requires rebuilding the index:
#   python scripts/regenerate_lancedb.py --clean
# KNOWLEDGE_BACKEND=auto

# ---------------------------------------------------------------------
# Asset Provisioning (files not checked into git)
# ---------------------------------------------------------------------
# Assets absent from git are downloaded/generated by scripts/provision_assets.py:
# at image build time for anything needing the network, and at container start
# for anything depending on mounted volumes.
#
# Where baked assets live inside the image. Deliberately outside /app, which
# docker-compose replaces with a bind mount of the host checkout.
# docker-compose maps the named volume `aoc-assets` here so the ~150MB model
# download survives image rebuilds. Clear it with `docker volume rm aoc_aoc-assets`.
# AOC_ASSET_ROOT=/opt/aoc
# Staging area for files destined for /app that the bind mount hides. Must stay
# OUTSIDE AOC_ASSET_ROOT: Docker only seeds a named volume while it is empty, so
# a seed inside the volume could never be updated by a later image.
# AOC_SEED_DIR=/opt/aoc-seed
# faster-whisper model baked into the image and loaded by STTEngine.
# Changing this re-downloads on next start unless the volume is cleared.
# AOC_STT_MODEL=base.en
# Vector index bootstrap on container start:
#   auto (default) build only when the database is missing
#   always         rebuild on every start
#   never          disable
# AOC_BOOTSTRAP_INDEX=auto
# Set to 1 to fail the docker build (or startup) when provisioning errors.
# AOC_PROVISION_STRICT=0
# Set to 0 to skip runtime provisioning entirely in entrypoint.sh.
# AOC_PROVISION_RUNTIME=1

# =============================================================================
# Concurrency
# =============================================================================
# The one system-wide cap on concurrent model-driven executions (scheduled
# runs, dream standup fan-out). Keeps bursts inside the per-minute quota.
# AOC_MAX_CONCURRENCY=3

