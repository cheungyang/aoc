# Environment Configuration Example

# ==============================================================================
# GitHub Configuration
# ==============================================================================
# GITHUB_TOKEN: Fine-grained GitHub Personal Access Token (PAT) for a Machine User.
# IMPORTANT: Use a dedicated Machine User (bot account) token rather than your primary
# human account token. This separates agent identity from human identity and enables
# developers to self-approve and review pull requests generated by the agent.
GITHUB_TOKEN=ghp_yourMachineUserTokenHere

# ==============================================================================
# LLM & AI Model Provider Keys
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# Search & External API Keys
# ==============================================================================
BRAVE_API_KEY=
RUNWAYML_API_SECRET=
SEATS_AERO_API_KEY=
RAPIDAPI_KEY=

# ==============================================================================
# LangSmith Observability & Tracing
# ==============================================================================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ==============================================================================
# PKM & Storage Paths (Optional / Defaults)
# ==============================================================================
PKM_DIR=~/pkm
TASKS_DB_PATH=~/pkm/tasks.db
PROJECTS_DB_PATH=~/pkm/projects.db
KNOWLEDGE_DB_PATH=~/pkm/.lancedb
