        "@read"
      ],
      "pkm/wallet/exercise/progression.jsonl": [
        "@write"
      ],
      "pkm/wallet/exercise/workout_history.jsonl": [
        "@write"
      ],
      "pkm/wallet/exercise/muscle_recovery.json": [
        "@write"
      ]
    },
    "google_health": {
      "sleep": [
        "@observe"
      ],
      "exercise": [
        "@observe",
        "@log"
      ]
    }
  }
