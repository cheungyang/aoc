<?xml version="1.0" encoding="UTF-8"?>
<!--
  Starts Agent Chrome + the NAS-only forwarder at login and restarts the
  forwarder if it exits. Install:

    sed -e "s#__REPO__#$PWD#g" -e "s#__NAS_IP__#192.168.1.10#g" \
        scripts/desktop_agent_chrome/com.aoc.agent-chrome.plist \
        > ~/Library/LaunchAgents/com.aoc.agent-chrome.plist
    launchctl load ~/Library/LaunchAgents/com.aoc.agent-chrome.plist

  Remove: launchctl unload ~/Library/LaunchAgents/com.aoc.agent-chrome.plist
  Logs:   /tmp/aoc-agent-chrome.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aoc.agent-chrome</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/scripts/desktop_agent_chrome/start_agent_chrome.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>NAS_IP</key>
        <string>__NAS_IP__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/tmp/aoc-agent-chrome.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aoc-agent-chrome.log</string>
</dict>
</plist>
