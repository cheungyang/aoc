{
  "agent_id": "script-executor",
  "channels": [
    "general"
  ],
  "name": "Terminator",
  "description": "A special non-LLM agent responsible for executing scheduled cron scripts.",
  "emoji": "⚙️",
  "schedules": [
    {
      "id": "nightly-sync",
      "kind": "script",
      "channel": "general",
      "thread": "cronjobs",
      "cron": "0 0 * * *",
      "script": [
        "sync_tasks.py",
        "sync_projects.py",
        "sync_knowledge.py",
        "wiki_scanner.py"
      ]
    },
    {
      "id": "dream-standup",
      "kind": "script",
      "channel": "general",
      "thread": "dreams",
      "cron": "0 23 * * *",
      "script": "dream_standup.py"
    },
    {
      "id": "hourly-git-sync",
      "kind": "script",
      "channel": "general",
      "thread": "cronjobs",
      "cron": "0 */1 * * *",
      "script": "sync_git.py"
    },
    {
      "id": "coding-tick",
      "kind": "script",
      "channel": "software-dev",
      "cron": "*/5 * * * *",
      "script": "coding_tick.py"
    },
    {
      "id": "job-reaper",
      "kind": "script",
      "channel": "general",
      "thread": "cronjobs",
      "cron": "*/5 * * * *",
      "script": "reap_jobs.py"
    }
  ]
}