        "script sync_projects.py",
        "script sync_knowledge.py",
        "script wiki_scanner.py"
      ]
    },
    {
      "channel": "general",
      "thread": "dreams",
      "cron": "0 23 * * *",
      "prompt": [
        "script dream_standup.py"
      ]
    },
    {
      "channel": "general",
      "thread": "cronjobs",
      "cron": "0 */1 * * *",
      "prompt": [
        "script sync_git.py"
      ]
    },
    {
      "channel": "software-dev",
      "cron": "*/5 * * * *",
      "prompt": [
        "script coding_tick.py"
      ]
    }
  ]
