{
  "agent_id": "script-executor",
  "name": "Terminator",
  "description": "A special non-LLM agent responsible for executing scheduled cron scripts.",
  "emoji": "⚙️",
  "schedules": [
    {
      "channel": "general-aoc",
      "thread": "cronjobs",
      "cron": "0 * * * *",
      "prompt": [
        "tool git {\"action\": \"pull\", \"path\": \"pkm\", \"agent_id\": \"script-executor\"}",
        "tool git {\"action\": \"push\", \"path\": \"pkm\", \"agent_id\": \"script-executor\", \"message\": \"Cron update\"}"
      ]
    }
  ],
  "tools": {
    "git": {
      "pkm": [
        "pull",
        "push"
      ],
      ".": [
        "pull",
        "push"
      ]
    }
  }
}