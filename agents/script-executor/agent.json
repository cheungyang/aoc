{
  "agent_id": "script-executor",
  "name": "Terminator",
  "description": "A special non-LLM agent responsible for executing scheduled cron scripts.",
  "emoji": "⚙️",
  "schedules": [
    {
      "channel": "general-aoc",
      "thread": "cronjobs",
      "cron": "0 * * * *",
      "prompt": [
        "tool git {\"command\": \"pull\", \"path\": \"pkm\"}",
        "tool git {\"command\": \"commit -am 'cron update'\", \"path\": \"pkm\"}",
        "tool git {\"command\": \"push\", \"path\": \"pkm\"}",
        "script software-orchestrator.py"
      ]
    }
  ],
  "tools": {
    "git": []
  }
}