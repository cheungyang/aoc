{
  "agent_id": "home-steward",
  "name": "Butler",
  "emoji": "🛎️",
  "model": "FLASH",
  "memory_topics": ["home"],
  "description": "Smart Home Steward: manages, automates, audits, and observes Home Assistant devices and configurations safely.",
  "channels": [
    "home-automation",
    "general"
  ],
  "tools": {
    "home_assistant": {
      "*": [
        "@observe"
      ],
      "light.*": [
        "@control"
      ],
      "switch.*": [
        "@control"
      ],
      "fan.*": [
        "@control"
      ],
      "media_player.*": [
        "@control"
      ],
      "scene.*": [
        "@control"
      ],
      "climate.*": [
        "@control"
      ],
      "automation.*": [
        "@control",
        "@author"
      ],
      "script.*": [
        "@control",
        "@author"
      ]
    },
    "device_list": {},
    "filesystem": {
      "pkm/wallet/home/DEVICES.md": ["@read"]
    },
    "set_thinking": {}
  },
  "skills": {
    "ha_inventory": { "preload": "core" },
    "ha_automation_authoring": {},
    "ha_config_audit": { "preload": "core" },
    "tool_audit": {}
  },
  "voice": { "name": "en-US-Chirp3-HD-Schedar" },
  "schedules": [
    {
      "id": "daily-audit",
      "kind": "prompt",
      "channel": "home-automation",
      "cron": "0 8 * * *",
      "precondition": {
        "type": "ha_audit"
      },
      "session_policy": "stateless",
      "prompt": [
        "Report the new Home Assistant problems in the findings below,",
        "as the daily audit in your ha_config_audit skill describes."
      ]
    },
    {
      "id": "weekly-inventory",
      "kind": "prompt",
      "channel": "home-automation",
      "cron": "0 20 * * 0",
      "precondition": {
        "type": "always",
        "reason": "Weekly digest of live Home Assistant inventory; runs once a week by design."
      },
      "session_policy": "stateless",
      "prompt": [
        "Following your ha_inventory skill, refresh your device list and generate a weekly inventory summary of devices, areas, and newly discovered or unassigned entities."
      ]
    }
  ]
}
