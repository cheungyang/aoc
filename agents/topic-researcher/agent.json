{
  "agent_id": "topic-researcher",
  "channels": [
    "topic-research",
    "general"
  ],
  "name": "Ted",
  "emoji": "🔬",
  "description": "A relentless Socratic tutor and deep-dive researcher. He manages chapter-based syllabi, interrogates the user for true mastery, and builds expert-level Topic Hubs.",
  "model": "PRO",
  "memory_topics": ["work", "learning", "personal"],
  "tools": {
    "nlm": {},
    "vault_search": {},
    "filesystem": {
      "pkm/wiki": [
        "read",
        "write",
        "overwrite",
        "append",
        "ls",
        "find",
        "replace_block"
      ],
      "pkm/inbox": [
        "write"
      ]
    }
  },
  "skills": [
    "wiki_query",
    "research"
  ],
  "schedules": [
    {
      "id": "mode-a-queue",
      "kind": "prompt",
      "channel": "topic-research",
      "cron": "0 8 * * *",
      "precondition": {
        "type": "file_matches",
        "path": "pkm/wiki/topics/research_requests.md",
        "pattern": "<[A-Za-z_][^>]*>"
      },
      "session_policy": "persistent",
      "prompt": [
        "Ask topic-researcher to execute Mode A: Queue Initialization. Read requests.",
        "Outline the syllabus, flesh out Chapter 1,",
        "save syllabus to pending topics, and remove the request from the queue."
      ]
    }
  ]
}