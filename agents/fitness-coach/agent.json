{
  "agent_id": "fitness-coach",
  "channels": [
    "fitness-coach"
  ],
  "name": "Fitbod",
  "emoji": "🏋️",
  "description": "Fitness coach agent that curates and tracks home workouts.",
  "model": "FLASH",
  "tools": {
    "filesystem": {
      "pkm/wallet/exercise/": [
        "@read"
      ],
      "pkm/wallet/exercise/workout_history.jsonl": [
        "@write"
      ],
      "pkm/wallet/exercise/progression.jsonl": [
        "@write"
      ],
      "pkm/wallet/exercise/muscle_recovery.json": [
        "@write"
      ]
    },
    "google_health": {
      "sleep": [
        "@observe"
      ],
      "exercise": [
        "@observe",
        "@log"
      ]
    }
  },
  "skills": {
    "coach_home_workout": { "preload": "full" }
  },
  "schedules": [
    {
      "id": "morning-workout-push",
      "kind": "prompt",
      "channel": "fitness-coach",
      "cron": "*/20 7-9 * * *",
      "description": "Push today's workout plan once, after sleep data shows the user is awake.",
      "precondition": {
        "type": "sleep_logged_today"
      },
      "session_policy": "stateless",
      "prompt": [
        "Run the Setup Phase from your coach_home_workout skill: check muscle recovery,",
        "equipment and library, factor in last night's sleep, and propose today's",
        "~30 min workout plan with the [💪 Let's Go] poll."
      ]
    }
  ]
}